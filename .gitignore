# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 用户配置与敏感信息（含 cookies、.env）
.config/

# 真实配置文件（.env.example 可以提交，.env 不可以）
.env
.env.local
*.env

# 工作目录产物
*.wav
*.mp4
*.mkv
*.webm
*.mov

# watch 插件工作目录（默认在用户当前工作目录生成）
.watch-work/

# 临时文件
*.tmp
*.log
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Local runtimes, weights and verification artifacts
.venv/
.models/
installation-test/
tools/
codex-adapter/runtime.json
codex-adapter/requirements.lock.txt
codex-adapter/gpu-validation.json
codex-adapter/device-comparison.json
